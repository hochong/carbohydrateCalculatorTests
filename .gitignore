# ============================================================
# .gitignore for Java + Maven + Selenium + Cucumber project
# ============================================================

# ----- Maven build output -----
target/
!.mvn/wrapper/maven-wrapper.jar

# ----- Java compiled files -----
*.class
*.jar
*.war
*.ear
*.nar

# ----- IDE - IntelliJ IDEA -----
.idea/
*.iml
*.iws
*.ipr
out/

# ----- IDE - Eclipse -----
.classpath
.project
.settings/
bin/

# ----- IDE - VS Code -----
.vscode/

# ----- IDE - NetBeans -----
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# ----- WebDriverManager cache (auto-downloaded browser drivers) -----
.cache/
.wdm/

# ----- Cucumber / test reports -----
target/cucumber-reports/
target/surefire-reports/

# ----- Screenshots captured on test failure -----
screenshots/
test-output/

# ----- OS generated files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
logs/
